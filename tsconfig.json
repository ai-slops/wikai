{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true, "noEmit": true,
    "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true, "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["apps/dashboard/public", "node_modules"]
}
