---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { loadContent, publicPathFor, searchPages } from "../lib/content.ts";

const { pages } = await loadContent();
const searchable = searchPages(pages, true).map((page) => ({
  title: page.metadata.title,
  summary: page.metadata.summary ?? "",
  tags: page.metadata.tags,
  kind: page.metadata.kind,
  path: publicPathFor(page),
}));
---
<BaseLayout title="Search — Wikai" description="Search public work and knowledge, with logs available by choice." noindex>
  <PageHeader eyebrow="Public index" title="Search" summary="Work and knowledge are included by default. Add dated logs when you need the full record." />
  <section class="search-panel" aria-labelledby="search-label">
    <div class="search-controls">
      <label id="search-label">Search the public index<input id="query" type="search" autocomplete="off" placeholder="Title, summary, or tag" /></label>
      <label class="check"><input id="include-log" type="checkbox" /> Include Log</label>
    </div>
    <p id="search-status" class="search-status" aria-live="polite">{searchable.filter((entry) => entry.kind !== "log").length} results</p>
    <ol id="search-results" class="entry-list">
      {searchable.map((entry) => (
        <li class="entry" data-kind={entry.kind} data-search={`${entry.title} ${entry.summary} ${entry.tags.join(" ")}`.toLocaleLowerCase()} hidden={entry.kind === "log"}>
          <div class="entry-meta">{entry.kind}</div>
          <div><h3><a href={entry.path}>{entry.title}</a></h3>{entry.summary !== "" && <p>{entry.summary}</p>}</div>
        </li>
      ))}
    </ol>
  </section>
  <script type="module" src="/_assets/search.js" is:inline></script>
</BaseLayout>
